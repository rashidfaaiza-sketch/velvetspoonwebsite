# Node 24+. Copy to .env; never commit .env or database files.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Exact browser origin, including port. Use your HTTPS domain in production.
APP_ORIGIN=http://127.0.0.1:3000
# Persistent local disk, NOT ephemeral/serverless storage.
DATA_DIR=./data
# demo = never collects/marks payments. test = Razorpay sandbox. live = real charges.
PAYMENT_MODE=demo
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ADMIN_USERNAME=baker
# Run node scripts/configure-admin.js to generate a scrypt hash securely.
ADMIN_PASSWORD_HASH=
# At least 32 random characters. Required in production; configure-admin creates one.
SESSION_SECRET=
# Optional customer confirmation email. No emails sent unless host + from are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Browser tests use system Chromium; change this path on other machines.
CHROMIUM_PATH=/usr/bin/chromium
